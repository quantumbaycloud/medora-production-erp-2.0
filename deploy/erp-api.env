APP_BASE_URL=https://erp.meodrax.in
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=medorax
POSTGRES_USER=medorax
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://medorax:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/medorax

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=https://erp.meodrax.in

STORAGE_ENDPOINT=https://CHANGE_ME_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_SECURE=true
STORAGE_BUCKET_PRESCRIPTIONS=prescriptions
STORAGE_BUCKET_DOCUMENTS=documents

EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@medorax.com
EMAIL_FROM_NAME=Medorax
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_KEY

LICENSE_ISSUER_URL=https://api.medorax.in/licensing
LICENSE_PUBLIC_KEY_FILE=/run/secrets/medorax-license/public.pem
LICENSE_OFFLINE_GRACE_HOURS=24

ERP_PROVISION_TOKEN=CHANGE_ME_LONG_RANDOM_PROVISION_TOKEN

ADMIN_SYNC_URL=https://api.medorax.in/api
ADMIN_SYNC_TIMEOUT_SECONDS=10

AUTO_CREATE_TABLES=false
