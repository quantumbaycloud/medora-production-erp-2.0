# Application
APP_BASE_URL=http://localhost:8000
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medorax

# Authentication
JWT_SECRET=change-this-in-local-development-must-be-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis # Redis & Celery Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SECURE=false
STORAGE_BUCKET_PRESCRIPTIONS=prescriptions
STORAGE_BUCKET_DOCUMENTS=documents

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@medorax.com
EMAIL_FROM_NAME=Medorax
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Internal
INTERNAL_API_KEY=change-this-internal-key

# AI / Elasticsearch (Optional)
ELASTICSEARCH_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus

# Commercial licensing
LICENSE_ISSUER_URL=https://api.medorax.in/licensing
LICENSE_PUBLIC_KEY_FILE=/run/secrets/medorax-license/public.pem
LICENSE_OFFLINE_GRACE_HOURS=24

# ERP internal provisioning (must match onboarding admin API)
ERP_PROVISION_TOKEN=CHANGE_ME_SHARED_PROVISION_TOKEN

