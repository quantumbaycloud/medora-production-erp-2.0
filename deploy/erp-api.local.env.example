APP_BASE_URL=http://localhost:8000
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://medorax:medorax_local_dev_2026@postgres:5432/medorax

JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET_32_CHARS_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SECURE=false
STORAGE_BUCKET_PRESCRIPTIONS=prescriptions
STORAGE_BUCKET_DOCUMENTS=documents

