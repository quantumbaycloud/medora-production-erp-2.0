CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
