# Application
APP_BASE_URL=http://localhost:8000
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medorax

# Authentication
JWT_SECRET=change-this-in-local-development-must-be-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis # Redis & Celery Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SECURE=false
STORAGE_BUCKET_PRESCRIPTIONS=prescriptions
STORAGE_BUCKET_DOCUMENTS=documents

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@medorax.com
EMAIL_FROM_NAME=Medorax
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Internal
INTERNAL_API_KEY=change-this-internal-key

# AI / Elasticsearch (Optional)
ELASTICSEARCH_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus


# ============================================================
# MEDORAX COMMERCIAL LICENSING
# ============================================================

# Public licensing authority used by the ERP for license validation.
# Production:
LICENSE_ISSUER_URL=https://api.medorax.in/licensing

# Path to the Ed25519 PUBLIC key used to verify licenses.
# NEVER put the licensing issuer private key in the ERP.
LICENSE_PUBLIC_KEY_FILE=./keys/medorax-license/public.pem

# Optional offline validation grace period.
LICENSE_OFFLINE_GRACE_HOURS=24

# ============================================================
# MEDORAX ONBOARDING -> ERP PROVISIONING
# ============================================================

# Secret used ONLY by the onboarding Admin API to provision
# an approved customer into the ERP.
#
# Generate a strong value:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ERP_PROVISION_TOKEN=tmEgMKCdlVW3CmCDrvb-mOaq_Cy7dgrbupiay6ZHUt_qPGmZrDvnO2GgbAkp28y-
# Production schema management: use Alembic in production.
AUTO_CREATE_TABLES=false

# Central Medorax Admin API base, e.g. https://api.medorax.in/api
ADMIN_SYNC_URL=
ADMIN_SYNC_TIMEOUT_SECONDS=10
